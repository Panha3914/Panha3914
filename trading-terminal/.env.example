# Safe default. This scaffold must not execute live orders.
TRADING_MODE=paper
MT5_ENABLED=false
MT5_PATH=
MT5_SYMBOL=XAUUSD
MT5_TIMEFRAME=M5
AUDIT_LOG_PATH=logs/trading-terminal.jsonl
RISK_STATE_DB_PATH=logs/risk-state.sqlite3
PAPER_STATE_DB_PATH=logs/paper-portfolio.sqlite3
PAPER_INITIAL_BALANCE=10000
PAPER_SLIPPAGE_POINTS=2
PAPER_COMMISSION_PER_LOT_ROUND_TURN=0
MT5_TIMEOUT_SECONDS=10
QUOTE_MAX_AGE_SECONDS=5
MAX_SPREAD_POINTS=50
MAX_RISK_PER_TRADE_PERCENT=0.25
MAX_DAILY_LOSS_PERCENT=2.0
MAX_DRAWDOWN_PERCENT=5.0
MAX_OPEN_POSITIONS=1
MAX_POSITION_VOLUME=0.01
KILL_SWITCH=true
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
